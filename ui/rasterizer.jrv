module Rasterizer
complexity O(N)
{
    import Math3D;

    verify {
        test "draw_cube_proof" {
            assert(draw_cube() == 1);
        }
    }

    func draw_cube() -> I32 {
        budget { power: 10000_nj }
        
        // Vertices of a cube
        let x = 100;
        let y = 100;
        let z = 50;
        
        // Project a vertex
        let px = Math3D.project_x(x, z);
        let py = Math3D.project_y(y, z);
        
        // Draw the projected point
        draw_point(px, py);
        
        return 1;
    }

    verify {
        test "draw_point_proof" {
            assert(draw_point(10, 10) == 1);
        }
    }

    func draw_point(x: I32, y: I32) -> I32 {
        budget { power: 500_nj }
        // Simulated framebuffer write
        return 1;
    }
}

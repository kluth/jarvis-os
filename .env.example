# JARVIS OS - AI Symbiosis Configuration
# Populate these keys to enable real-world LLM-driven synthesis

# Your OpenAI or Anthropic API Key
JARVIS_LLM_API_KEY=sk-xxxx-replace-me

# Synthesis Model (e.g., gpt-4o, claude-3-5-sonnet)
JARVIS_LLM_MODEL=gpt-4o

# Enable Autonomous Mode (1 = ON, 0 = OFF)
JARVIS_AUTONOMOUS_EVOLUTION=1

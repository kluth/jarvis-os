// HAL.Input — Sovereign PS/2 keyboard + mouse driver.
// Talks directly to the 8042 controller via I/O ports 0x60/0x64.
// Pure .jrv. Replaces previous Rust pc-keyboard dependency.
module HAL_Input {
    complexity O(1) {
        struct KeyEvent {
            scancode: I32,
            pressed: I32,
            modifiers: I32
        }

        const PS2_DATA  = 0x60;
        const PS2_STAT  = 0x64;
        const PS2_CMD   = 0x64;

        memory last_scancode: I32 = 0;
        memory key_count: I32 = 0;
        memory shift_held: I32 = 0;

        verify {
            test "input_init_proof" {
                let st = init();
                assert(st == 1);
            }
        }
        func init() -> I32 {
            budget { power: 2000_nj }
            // Disable both PS/2 ports while configuring.
            port write(0x64, 0xAD);
            port write(0x64, 0xA7);
            // Flush output buffer (real read).
            let _junk = port read(0x60);
            // Set configuration: enable IRQ1, disable IRQ12, no translation.
            port write(0x64, 0x60);
            port write(0x60, 0x01);
            // Re-enable first PS/2 port.
            port write(0x64, 0xAE);
            contract { ensures result == 1; }
            return 1;
        }

        verify {
            test "input_on_irq_proof" {
                let r = on_keyboard_irq(0x1E);
                assert(r == 1);
            }
        }
        func on_keyboard_irq(scancode: I32) -> I32 {
            budget { power: 300_nj }
            last_scancode = scancode;
            atomic_add(key_count, 1);
            // Track shift modifier (0x2A = LShift down, 0xAA = LShift up).
            if scancode == 0x2A {
                shift_held = 1;
            }
            if scancode == 0xAA {
                shift_held = 0;
            }
            // EOI to slave-less PIC for IRQ1.
            port write(0x20, 0x20);
            return 1;
        }

        verify {
            test "input_get_last_proof" {
                let s = get_last();
                assert(s >= 0);
            }
        }
        func get_last() -> I32 {
            budget { power: 50_nj }
            return last_scancode;
        }
    }
}
